<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>ColiDev</string>
    <key>CFBundleName</key>
    <string>Creator</string>
    <key>LSHasLocalizedDisplayName</key>
    <true/>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Creator listens to your voice question in the Workshop only while you hold the microphone button or ⌃⌥V. Speech is recognized on this Mac.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Creator turns your voice question into text on this Mac (on-device recognition) to ask the Workshop assistant.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUFeedURL</key>
    <string>$(SUFeedURL)</string>
    <key>SUPublicEDKey</key>
    <string>$(SUPublicEDKey)</string>
    <key>SURequireSignedFeed</key>
    <true/>
    <key>SUVerifyUpdateBeforeExtraction</key>
    <true/>
</dict>
</plist>
